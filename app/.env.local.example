# ---- Shiny : variables du serveur (copier en .env.local en local, et dans Vercel > Settings > Environment Variables)

# RPC Solana (Helius conseillé)
SOLANA_RPC_URL=
# Clé du portail Jupiter (developers.jup.ag/portal). Vide = API publique, plus lente.
JUPITER_API_KEY=

# Trésorerie : reçoit l'argent. Le serveur n'a jamais sa clé. Jamais affichée sur le site.
TREASURY_WALLET=
# Wallet de gains : achète et envoie les tokens. Créé par `npm run wallet:new`. Ne jamais partager.
PAYOUT_SECRET=

# Où arrivent les paiements des joueurs :
#   treasury = directement sur TREASURY_WALLET (option A) : tu recharges le wallet de gains toi-même
#   payout   = sur le wallet de gains (option B) : le bénéfice part vers TREASURY_WALLET toutes les heures
PAY_TO=treasury

# Envoi des gains :
#   simulate = aucun achat réel : le tirage est fait, les achats sont seulement chiffrés avec de vrais prix Jupiter
#   live     = vrais achats et vrais envois
PAYOUT_MODE=simulate

# Sécurité
# Réserve gardée sur le wallet de gains (option B : le surplus part à la trésorerie ; les deux : sous ce seuil, plus de nouveaux tirages)
RESERVE_SOL=80
# Plafond de gains envoyés par heure (SOL)
HOURLY_PAYOUT_CAP_SOL=60
# Coût d'ouverture des comptes de tokens du joueur : deduct = pris sur la valeur achetée, house = payé par la maison
ATA_RENT=deduct
# Secret pour la tâche horaire Vercel (option B)
CRON_SECRET=

# Base de données des tirages (Upstash Redis, obligatoire en ligne). Vide en local = fichiers dans .data/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dev local uniquement : true = on peut tester tout le parcours sans payer (signature « SIM-… »). Ignoré en production.
DEV_FAKE_PAYMENTS=false
